<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0">

    <title>Je t'aime mon amour 🌻</title>

    <style>

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        html,
        body {
            width: 100%;
            height: 100%;
            overflow: hidden;
        }

        body {

            background: #010301;

            font-family:
                Georgia,
                "Times New Roman",
                serif;
        }


        /* =====================================
           UNIVERSE
        ===================================== */

        .universe {

            position: relative;

            width: 100vw;
            height: 100vh;

            overflow: hidden;

            background:

                radial-gradient(
                    circle at 50% 50%,
                    rgba(130, 135, 10, 0.45) 0%,
                    rgba(55, 65, 0, 0.28) 20%,
                    rgba(10, 18, 0, 0.8) 48%,
                    #010301 78%
                );
        }


        /* =====================================
           NEBULA
        ===================================== */

        .universe::before {

            content: "";

            position: absolute;

            width: 900px;
            height: 900px;

            left: 50%;
            top: 50%;

            transform:
                translate(-50%, -50%);

            border-radius: 50%;

            background:

                radial-gradient(
                    circle,
                    rgba(255, 255, 80, 0.15),
                    rgba(150, 160, 0, 0.06) 35%,
                    transparent 70%
                );

            filter: blur(20px);

            animation:
                nebula 8s ease-in-out infinite;
        }


        @keyframes nebula {

            0%,
            100% {
                transform:
                    translate(-50%, -50%)
                    scale(0.9);
            }

            50% {
                transform:
                    translate(-50%, -50%)
                    scale(1.15);
            }
        }


        /* =====================================
           STARS
        ===================================== */

        .stars {

            position: absolute;

            inset: 0;

            background-image:

                radial-gradient(
                    circle,
                    white 1px,
                    transparent 1.5px
                ),

                radial-gradient(
                    circle,
                    #ffff80 1px,
                    transparent 1.5px
                ),

                radial-gradient(
                    circle,
                    #ffffff 0.7px,
                    transparent 1px
                );

            background-size:
                100px 100px,
                170px 170px,
                250px 250px;

            background-position:
                10px 20px,
                50px 80px,
                120px 30px;

            opacity: 0.7;

            animation:
                starsMove 35s linear infinite;
        }


        @keyframes starsMove {

            from {
                transform:
                    translate(0, 0);
            }

            to {
                transform:
                    translate(-120px, 90px);
            }
        }


        /* =====================================
           RANDOM PARTICLES
        ===================================== */

        .particle {

            position: absolute;

            width: 2px;
            height: 2px;

            border-radius: 50%;

            background: #fff;

            box-shadow:
                0 0 5px #ffff80;

            animation:
                twinkle
                var(--duration)
                ease-in-out
                infinite;

            animation-delay:
                var(--delay);
        }


        @keyframes twinkle {

            0%,
            100% {
                opacity: 0.1;
                transform: scale(0.5);
            }

            50% {
                opacity: 1;
                transform: scale(2);
            }
        }


        /* =====================================
           CENTER
        ===================================== */

        .core {

            position: absolute;

            top: 50%;
            left: 50%;

            width: 180px;
            height: 180px;

            transform:
                translate(-50%, -50%);

            display: flex;

            justify-content: center;
            align-items: center;

            z-index: 20;
        }


        .core-glow {

            position: absolute;

            width: 180px;
            height: 180px;

            border-radius: 50%;

            background:
                rgba(255, 255, 0, 0.5);

            filter:
                blur(55px);

            animation:
                glow 3s ease-in-out infinite;
        }


        @keyframes glow {

            0%,
            100% {
                transform: scale(0.7);
                opacity: 0.25;
            }

            50% {
                transform: scale(1.3);
                opacity: 0.6;
            }
        }


        .heart {

            position: relative;

            z-index: 3;

            font-size: 70px;

            filter:

                drop-shadow(
                    0 0 8px #ffff00
                )

                drop-shadow(
                    0 0 25px #ffff00
                )

                drop-shadow(
                    0 0 45px #ffff00
                );

            animation:
                heartbeat 2s infinite;
        }


        @keyframes heartbeat {

            0%,
            100% {
                transform: scale(1);
            }

            50% {
                transform: scale(1.15);
            }
        }


        .center-text {

            position: absolute;

            top: 125px;

            z-index: 4;

            color: white;

            font-size: 18px;

            white-space: nowrap;

            text-shadow:

                0 0 5px #ffff00,
                0 0 15px #ffff00,
                0 0 25px #ffff00;
        }


        /* =====================================
           ORBITS
        ===================================== */

        .orbit {

            position: absolute;

            top: 50%;
            left: 50%;

            border:
                1px solid
                rgba(255, 255, 100, 0.08);

            border-radius: 50%;

            transform:
                translate(-50%, -50%);

            pointer-events: none;
        }


        .orbit-1 {

            width: 280px;
            height: 180px;

            animation:
                orbit1
                12s
                linear
                infinite;
        }


        .orbit-2 {

            width: 420px;
            height: 270px;

            animation:
                orbit2
                18s
                linear
                infinite
                reverse;
        }


        .orbit-3 {

            width: 600px;
            height: 390px;

            animation:
                orbit3
                26s
                linear
                infinite;
        }


        .orbit-4 {

            width: 820px;
            height: 530px;

            animation:
                orbit4
                38s
                linear
                infinite
                reverse;
        }


        @keyframes orbit1 {

            from {
                transform:
                    translate(-50%, -50%)
                    rotate(0deg);
            }

            to {
                transform:
                    translate(-50%, -50%)
                    rotate(360deg);
            }
        }


        @keyframes orbit2 {

            from {
                transform:
                    translate(-50%, -50%)
                    rotate(0deg);
            }

            to {
                transform:
                    translate(-50%, -50%)
                    rotate(360deg);
            }
        }


        @keyframes orbit3 {

            from {
                transform:
                    translate(-50%, -50%)
                    rotate(0deg);
            }

            to {
                transform:
                    translate(-50%, -50%)
                    rotate(360deg);
            }
        }


        @keyframes orbit4 {

            from {
                transform:
                    translate(-50%, -50%)
                    rotate(0deg);
            }

            to {
                transform:
                    translate(-50%, -50%)
                    rotate(360deg);
            }
        }


        /* =====================================
           FLOWERS
        ===================================== */

        .flower {

            position: absolute;

            font-size: 43px;

            filter:

                drop-shadow(
                    0 0 5px #ffff00
                )

                drop-shadow(
                    0 0 12px rgba(255, 255, 0, 0.8)
                );

            animation:
                floatingFlower
                3s
                ease-in-out
                infinite;
        }


        @keyframes floatingFlower {

            0%,
            100% {
                margin-top: 0;
                transform: scale(1) rotate(-5deg);
            }

            50% {
                margin-top: -10px;
                transform: scale(1.15) rotate(5deg);
            }
        }


        /* =====================================
           FLOWER POSITIONS
        ===================================== */

        .orbit-1 .flower-1 {

            top: -28px;
            left: 50%;

            transform:
                translateX(-50%);
        }


        .orbit-2 .flower-2 {

            top: 20px;
            right: -28px;
        }


        .orbit-2 .flower-3 {

            bottom: -25px;
            left: 25%;
        }


        .orbit-3 .flower-4 {

            top: -30px;
            left: 25%;
        }


        .orbit-3 .flower-5 {

            right: -30px;
            top: 42%;
        }


        .orbit-3 .flower-6 {

            bottom: -30px;
            left: 55%;
        }


        .orbit-4 .flower-7 {

            top: 18%;
            left: -30px;
        }


        .orbit-4 .flower-8 {

            bottom: 5%;
            right: 12%;
        }


        /* =====================================
           FLOWER TEXT
        ===================================== */

        .flower-text {

            position: absolute;

            color: white;

            font-size: 12px;

            white-space: nowrap;

            text-shadow:
                0 0 5px #ffff00;
        }


        /* =====================================
           ROMANTIC MESSAGES
        ===================================== */

        .message {

            position: absolute;

            color: white;

            font-size: 18px;

            white-space: nowrap;

            text-shadow:

                0 0 5px #ffff00,
                0 0 15px #ffff00;

            animation:
                messageFloat
                4s
                ease-in-out
                infinite;

            z-index: 5;
        }


        .message-1 {

            top: 27%;
            left: 27%;
        }


        .message-2 {

            top: 48%;
            right: 8%;
        }


        .message-3 {

            bottom: 18%;
            left: 7%;
        }


        .message-4 {

            bottom: 25%;
            right: 20%;
        }


        .message-5 {

            top: 70%;
            left: 5%;
        }


        @keyframes messageFloat {

            0%,
            100% {
                transform:
                    translateY(0);
                opacity: 0.75;
            }

            50% {
                transform:
                    translateY(-10px);
                opacity: 1;
            }
        }


        /* =====================================
           BOTTOM MESSAGE
        ===================================== */

        .bottom-message {

            position: absolute;

            bottom: 25px;

            left: 50%;

            transform:
                translateX(-50%);

            color: white;

            font-size: 22px;

            text-align: center;

            white-space: nowrap;

            text-shadow:

                0 0 5px #ffff00,
                0 0 15px #ffff00,
                0 0 25px #ffff00;

            z-index: 30;
        }


        /* =====================================
           MOUSE PARALLAX
        ===================================== */

        .universe {

            transition:
                transform 0.3s ease-out;
        }


        /* =====================================
           MOBILE
        ===================================== */

        @media (max-width: 600px) {

            .orbit-1 {

                width: 220px;
                height: 140px;
            }

            .orbit-2 {

                width: 330px;
                height: 215px;
            }

            .orbit-3 {

                width: 470px;
                height: 300px;
            }

            .orbit-4 {

                width: 650px;
                height: 420px;
            }

            .flower {

                font-size: 31px;
            }

            .heart {

                font-size: 52px;
            }

            .center-text {

                font-size: 15px;
            }

            .message {

                font-size: 13px;
            }

            .bottom-message {

                font-size: 16px;
            }
        }

    </style>

</head>


<body>


    <div class="universe" id="universe">


        <!-- ESTRELLAS -->

        <div class="stars"></div>


        <!-- PARTICLES -->

        <div id="particles"></div>


        <!-- =================================
             CENTRO DEL UNIVERSO
        ================================== -->

        <div class="core">

            <div class="core-glow"></div>

            <div class="heart">
                ❤️
            </div>

            <div class="center-text">
                FELIZ 22❤️
            </div>

        </div>


        <!-- =================================
             ÓRBITA 1
        ================================== -->

        <div class="orbit orbit-1">

            <div class="flower flower-1">
                🌻
            </div>

        </div>


        <!-- =================================
             ÓRBITA 2
        ================================== -->

        <div class="orbit orbit-2">

            <div class="flower flower-2">
                🌻
            </div>

            <div class="flower flower-3">
                🌼
            </div>

        </div>


        <!-- =================================
             ÓRBITA 3
        ================================== -->

        <div class="orbit orbit-3">

            <div class="flower flower-4">
                🌻
            </div>

            <div class="flower flower-5">
                🌼
            </div>

            <div class="flower flower-6">
                🌻
            </div>

        </div>


        <!-- =================================
             ÓRBITA 4
        ================================== -->

        <div class="orbit orbit-4">

            <div class="flower flower-7">
                🌼
            </div>

            <div class="flower flower-8">
                🌻
            </div>

        </div>


        <!-- =================================
             MENSAJES
        ================================== -->

        <div class="message message-1">
            Mon petit chou ❤️
        </div>


        <div class="message message-2">
            mon cherie ☀️
        </div>


        <div class="message message-3">
            My Love ❤️
        </div>


        <div class="message message-4">
            Tu rends ma vie plus belle ❤️
        </div>


        <div class="message message-5">
            Eres amor de mi vida ❤️
        </div>


        <!-- =================================
             FINAL
        ================================== -->

        <div class="bottom-message">
            No es mucho pero es un regalo ❤️
        </div>


    </div>


    <script>

        /* =====================================
           CREATE PARTICLES
        ===================================== */

        const universe =
            document.getElementById("universe");

        const particles =
            document.getElementById("particles");


        for (let i = 0; i < 180; i++) {

            const particle =
                document.createElement("div");


            particle.className =
                "particle";


            particle.style.left =
                Math.random() * 100 + "%";


            particle.style.top =
                Math.random() * 100 + "%";


            const size =
                Math.random() * 3 + 1;


            particle.style.width =
                size + "px";


            particle.style.height =
                size + "px";


            particle.style.setProperty(
                "--duration",
                Math.random() * 4 + 2 + "s"
            );


            particle.style.setProperty(
                "--delay",
                Math.random() * 5 + "s"
            );


            particles.appendChild(
                particle
            );
        }


        /* =====================================
           MOUSE PARALLAX
        ===================================== */

        document.addEventListener(
            "mousemove",
            function (event) {

                const x =
                    (event.clientX /
                        window.innerWidth -
                        0.5) * 8;


                const y =
                    (event.clientY /
                        window.innerHeight -
                        0.5) * 8;


                universe.style.transform =
                    `translate(${x}px, ${y}px)`;
            }
        );


        /* =====================================
           RESET WHEN MOUSE LEAVES
        ===================================== */

        document.addEventListener(
            "mouseleave",
            function () {

                universe.style.transform =
                    "translate(0, 0)";
            }
        );

    </script>

</body>

</html>
